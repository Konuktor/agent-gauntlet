# ─────────────────────────────────────────────────────────────────────────────
# AgentGauntlet configuration
# Copy to `.env` and fill in. Every variable here is actually read by the app
# (see packages/config/src/env.ts — the single source of truth).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Matches docker-compose.yml, which publishes on 5433 to avoid
# colliding with a system Postgres on 5432.
DATABASE_URL=postgres://gauntlet:gauntlet@localhost:5433/gauntlet

# ── Solari ───────────────────────────────────────────────────────────────────
# Get one at https://console.getsolari.com. One slr_live_ key covers browsers,
# sandboxes and desktops. Without it the app runs in local/demo mode and says so.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com

# ── Execution mode ───────────────────────────────────────────────────────────
# auto   → solari when SOLARI_API_KEY is set, otherwise local
# solari → real Solari Browser + Sandbox (spends credits)
# local  → real Playwright Chromium on this machine + a local fixture (free)
GAUNTLET_MODE=auto

# ── LLM (optional) ───────────────────────────────────────────────────────────
# The default Reference Agent is deterministic and needs no key at all.
# These only power the optional LLM agent and the failure-explanation writer.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Cost + safety limits ─────────────────────────────────────────────────────
# Solari concurrency caps: Free = 3 browsers / 1 sandbox, Starter = 20 / 2,
# Professional = 150 / 10. A 429 is NOT retryable, so keep these under your cap.
GAUNTLET_MAX_CONCURRENCY=3
GAUNTLET_MAX_SANDBOXES=1
GAUNTLET_MAX_RUNS_PER_SUITE=50

# Point runs at an already-running fixture instead of provisioning a sandbox.
# Useful if your Solari deployment has no preview domain configured (HTTP 501).
GAUNTLET_FIXTURE_URL=

# Where run artifacts (rrweb replays, screenshots) are written.
GAUNTLET_ARTIFACT_DIR=.artifacts

# Base URL the CLI and worker use to reach the web API.
GAUNTLET_WEB_URL=http://localhost:3000

LOG_LEVEL=info

# Set to 1 to allow the real-credential Solari acceptance test to run.
SOLARI_E2E=0
