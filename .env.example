# ─────────────────────────────────────────────────────────────────────────────
# AgentGauntlet configuration
#
# Copy to `.env` and fill in. Every variable here is actually read by the app
# (packages/config/src/env.ts is the single source of truth).
#
# The ONLY credential the product needs is SOLARI_API_KEY. AgentGauntlet is
# agent-agnostic: the built-in Reference Agent is deterministic and needs no
# model at all, and external agents bring their own.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Matches docker-compose.yml, which publishes on 5433 to avoid
# colliding with a system Postgres on 5432.
DATABASE_URL=postgres://gauntlet:gauntlet@localhost:5433/gauntlet

# ── Solari ───────────────────────────────────────────────────────────────────
# Get one at https://console.getsolari.com. One slr_live_ key covers browsers
# and sandboxes. Without it the app runs in local mode and says so everywhere.
SOLARI_API_KEY=
SOLARI_BASE_URL=https://api.getsolari.com

# ── Execution mode ───────────────────────────────────────────────────────────
# auto   → solari when SOLARI_API_KEY is set, otherwise local
# solari → real Solari Browser + Sandbox (spends credits)
# local  → real Playwright Chromium on this machine + a local fixture (free)
GAUNTLET_MODE=auto

# ── Deployment ───────────────────────────────────────────────────────────────
# split  → a web service and a separate worker process (the local default)
# single → one process runs both, for a single Render web service

# Access code required to START a run. Browsing seeded results never needs one.
# REQUIRED for any public deployment that holds a Solari key — the app refuses
# to boot otherwise, because anyone who found the URL could spend your credits.
GAUNTLET_RUN_TOKEN=

# 32 random bytes, base64. Seals a credential a visitor lends the deployment —
# their own CDP endpoint or Solari key — so it is never queued in plaintext.
# Without it, "bring your own session/key" is simply refused rather than
# silently downgraded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GAUNTLET_CREDENTIAL_KEY=

GAUNTLET_PUBLIC_URL=

# ── Cost + safety limits ─────────────────────────────────────────────────────
# Solari's Free plan allows 3 concurrent browsers and 1 sandbox. A 429 is NOT
# retryable, so keep these at or under your plan's cap.
GAUNTLET_MAX_CONCURRENCY=3
GAUNTLET_MAX_SANDBOXES=1
GAUNTLET_MAX_RUNS_PER_SUITE=50

# Point runs at an already-running fixture instead of provisioning a sandbox.
# Useful if your Solari deployment has no preview domain configured (HTTP 501).
GAUNTLET_FIXTURE_URL=

# Where local run artifacts are written. Not used in production: replays are
# stored in Postgres, because a deployed container's filesystem is ephemeral.
GAUNTLET_ARTIFACT_DIR=.artifacts

LOG_LEVEL=info

# ── Optional, experimental ───────────────────────────────────────────────────
# Powers ONLY the optional LLM agent adapter. Nothing else reads it, no default
# workflow needs it, and its absence is never an error.
ANTHROPIC_API_KEY=
LLM_MODEL=

# Set to 1 to allow the real-credential Solari acceptance test to run.
SOLARI_E2E=0
