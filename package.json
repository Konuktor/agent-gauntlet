{
  "name": "agent-gauntlet",
  "version": "0.1.0",
  "private": true,
  "description": "Crash-test your browser agent before production does.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules dist .next .turbo",
    "db:generate": "pnpm --filter @gauntlet/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @gauntlet/db run migrate",
    "db:reset": "pnpm --filter @gauntlet/db run reset",
    "db:seed": "pnpm --filter @gauntlet/db run seed",
    "demo": "pnpm --filter @gauntlet/cli run start -- demo",
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"pnpm --filter @gauntlet/web run dev\" \"pnpm --filter @gauntlet/worker run dev\"",
    "fixture:dev": "pnpm --filter @gauntlet/fixture run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "gauntlet": "pnpm --filter @gauntlet/cli run start --",
    "lint": "turbo run lint",
    "render:build": "corepack enable && corepack prepare pnpm@11.7.0 --activate && pnpm install --frozen-lockfile && pnpm --filter @gauntlet/fixture run build && pnpm --filter @gauntlet/web run build",
    "render:start": "pnpm --filter @gauntlet/web run start",
    "screenshots": "tsx scripts/screenshots.ts",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"pnpm --filter @gauntlet/web run start\" \"pnpm --filter @gauntlet/worker run start\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:render": "vitest run --config vitest.render.config.ts",
    "test:solari": "vitest run --config vitest.solari.config.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
